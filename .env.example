DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ローカル: ネイティブPostgreSQLへのUnixソケット + peer認証
# ロール名はOSユーザー名と一致させる（例: OSユーザーがmomoならロールもmomo）
DATABASE_URL=postgres://momo@//var/run/postgresql/momotools

# 本番(VPS)専用: scripts/backup_db.sh がpg_dumpの認証に使う。ローカルのpeer認証では未使用。
# 本番の.envではTCP+パスワード接続用のDATABASE_URL(postgres://user:pass@127.0.0.1:5432/dbname)も設定する
POSTGRES_DB=momotools
POSTGRES_USER=momotools
POSTGRES_PASSWORD=change-me-in-prod-env-only
